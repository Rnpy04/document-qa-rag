# برای پاسخ‌دهی واقعی، یک کلید رایگان از https://openrouter.ai/keys بگیرید.
OPENROUTER_API_KEY=
# یک مدل رایگانِ موجود از https://openrouter.ai/collections/free-models انتخاب کنید.
# Router رسمی: یک مدل رایگانِ فعال را انتخاب می‌کند و از خطای مدل منقضی جلوگیری می‌کند.
OPENROUTER_MODEL=openrouter/free
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
